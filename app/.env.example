# URL of the deployed push worker (no trailing slash), e.g. https://aha-push.<you>.workers.dev
VITE_PUSH_URL=
# Output of `npm run vapid` in push-worker/
VITE_VAPID_PUBLIC_KEY=
# OAuth 2.0 Web client ID from Google Cloud Console, for cross-device progress sync (leave empty to disable)
VITE_GOOGLE_CLIENT_ID=
